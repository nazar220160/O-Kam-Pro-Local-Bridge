worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;
  client_max_body_size 8k;
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript;
  map $uri $web_cache_control {
    default "no-cache";
    ~^/_next/static/ "public, max-age=31536000, immutable";
  }
  server {
    listen ${WEB_LISTEN}:${WEB_PORT};
    server_name _;
    root /usr/share/nginx/html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control $web_cache_control always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' ${NEXT_CSP_HASHES}; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    location ~ ^/(api/|health$|openapi.json$|docs/?$) {
      proxy_pass http://${BRIDGE_HOST}:${BRIDGE_PORT};
      proxy_http_version 1.1;
      proxy_set_header Host 127.0.0.1:${BRIDGE_PORT};
      proxy_set_header X-Bridge-Gateway "${BRIDGE_GATEWAY_TOKEN}";
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Connection "";
      proxy_buffering off;
      proxy_request_buffering off;
      proxy_read_timeout 1h;
      proxy_send_timeout 1h;
    }
    location /_next/static/ {
      try_files $uri =404;
    }
    location / {
      try_files $uri $uri.html $uri/ =404;
    }
  }
}
